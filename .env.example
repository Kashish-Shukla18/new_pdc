# PDC local environment (copy to .env and edit).
# Real OS environment variables always override these values.
# .env is gitignored; commit only this example file.

# ── Postgres (address book + history) ───────────────────────────────────────
# Local: docker compose -f docker-compose.local.yaml up -d timescaledb  (:5433)
# Prod:  docker compose up -d  (localhost:5432; set POSTGRES_PASSWORD)
POSTGRES_DSN=postgres://pdc:pdc@127.0.0.1:5433/pdc?sslmode=disable
POSTGRES_RECONNECT_SEC=5s

# ── History writer (phase 2+; not wired into HandleFrame until phase 4) ──────
# Set true to enable Timescale history (CFG versions, events, and DATA frames).
ENABLE_HISTORY=false
# Legacy alias (used only if ENABLE_HISTORY is unset):
# ENABLE_SINK=false

HISTORY_QUEUE_SIZE=8192
HISTORY_EVENT_QUEUE_SIZE=1024
HISTORY_BATCH_SIZE=500
HISTORY_FLUSH_INTERVAL_MS=1000
HISTORY_INSERT_TIMEOUT_MS=15000
HISTORY_RECONNECT_MS=5000

# ── Measurement timestamps ──────────────────────────────────────────────────
# How field-device SOC wall-clock is reinterpreted → UTC at ingest.
#   local | host | auto | system  → timezone of the PC running this PDC
#   Asia/Kolkata | IST | UTC      → explicit IANA / alias
# Loopback (127.0.0.1) still defaults to UTC for lab sims unless timestamp_tz is set
# on the address-book row.
PMU_TIMESTAMP_TZ=local
# MAX_CLOCK_SKEW=5s
# DROP_QUALITY_REJECTED=true

# ── Quality / aligner (optional overrides) ──────────────────────────────────
# ALIGN_PERIOD_US=20000
# Startup default for per-PMU aligner RAM buffer (timestamps). Bounds/default live in
# aligner/buffer.go; Device Inventory reads them from the API (can change live).
# ALIGN_BUFFER_CAPACITY=200
# FRAME_CAPTURE_SIZE=1500
# PMU_STARTUP_STAGGER=2s
